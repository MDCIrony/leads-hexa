<mxCell id="v5" value="&lt;b style='font-size:14px'&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedor: React SPA · nginx]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Sirve la SPA y reenvía /api/v1/* al gateway&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#1168BD;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0B4884;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="225" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="v6" value="&lt;b style='font-size:14px'&gt;gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedor: nginx 1.27 · :8001]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Borde único: enruta por prefijo, autentica con auth_request (phantom token), CORS, Origin, X-Request-Id, límites. Publica /openapi/*.json; /internal/ → 404&lt;/span&gt;" style="fontFamily=Helvetica;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#1168BD;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0B4884;spacing=6;" vertex="1" parent="1"><mxGeometry x="650" y="225" width="980" height="80" as="geometry"/></mxCell>
