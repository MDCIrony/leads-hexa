<mxCell id="v1" value="&lt;b style='font-size:24px'&gt;Lead Router · cómo se comunican los componentes&lt;/b&gt;&lt;span style='font-size:13px'&gt;&amp;nbsp;&amp;nbsp;según docker-compose.yml, gateway/nginx.conf y el código&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#212529;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1500" height="40" as="geometry"/></mxCell>
<mxCell id="v2" value="&lt;b&gt;Navegador&lt;/b&gt; · SPA servida por &lt;i&gt;frontend&lt;/i&gt; (nginx :80), que reenvía /api/v1/* al gateway" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#DEE2E6;strokeColor=#868E96;fontColor=#212529;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="v3" value="&lt;b&gt;Integración del cliente&lt;/b&gt; · X-Api-Key {agent_id}.{secreto} · p. ej. test-consumer" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#DEE2E6;strokeColor=#868E96;fontColor=#212529;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="gw" value="" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#E7F5FF;strokeColor=#1971C2;strokeWidth=1.5;fontColor=#212529;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="1900" height="215" as="geometry"/></mxCell>
<mxCell id="v4" value="&lt;b style='font-size:17px'&gt;gateway&lt;/b&gt; · nginx 1.27 · :8001 en el host, :8080 en la red&lt;ul style='margin:6px 0 0 0;padding-left:16px;line-height:1.45'&gt;&lt;li&gt;Enruta por prefijo; &lt;code&gt;upstream … resolve&lt;/code&gt; con el DNS de Docker&lt;/li&gt;&lt;li&gt;Autentica con &lt;code&gt;auth_request&lt;/code&gt; (phantom token, ②–④)&lt;/li&gt;&lt;li&gt;CORS por &lt;code&gt;map&lt;/code&gt; exacto; escritura con Origin ajeno → 403&lt;/li&gt;&lt;li&gt;&lt;code&gt;Authorization&lt;/code&gt; del cliente siempre sobrescrito&lt;/li&gt;&lt;li&gt;Errores propios con el sobre JSON: 401 · 413 · 429 · 503&lt;/li&gt;&lt;li&gt;X-Request-Id: conserva el seguro o genera &lt;code&gt;$request_id&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#212529;fontSize=14;" vertex="1" parent="1"><mxGeometry x="635" y="80" width="560" height="250" as="geometry"/></mxCell>
<mxCell id="v5" value="&lt;table style='border-collapse:collapse;font-size:13px'&gt;&lt;tr&gt;&lt;th style='padding:1px 8px;text-align:left;border-bottom:1.5px solid #1971C2'&gt;Prefijo&lt;/th&gt;&lt;th style='padding:1px 8px;text-align:left;border-bottom:1.5px solid #1971C2'&gt;Upstream&lt;/th&gt;&lt;th style='padding:1px 8px;text-align:left;border-bottom:1.5px solid #1971C2'&gt;auth_request&lt;/th&gt;&lt;th style='padding:1px 8px;text-align:left;border-bottom:1.5px solid #1971C2'&gt;Nota&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/api/v1/auth/&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;identity&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;no&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;limit_req 20 r/s, ráfaga 60 → 429&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/api/v1/agents y /api/v1/agents/ (exactas)&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;identity&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;opcional&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;204 sin credencial: bootstrap del ADMIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/api/v1/agents/…, /api/v1/tenants[/…]&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;identity&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;sí&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/api/v1/sources[/…], /api/v1/intake/&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;intake&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;sí&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;client_max_body_size 10m → 413&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/api/v1/notifications[/…]&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;notifications&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;sí&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/api/v1/ (resto: leads, rules, groups, advisors)&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;lead-core&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;sí&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/openapi.json, /docs&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;lead-core&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;no&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;sin Cookie&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/openapi/{identity,notifications,intake}.json&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;cada servicio&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;no&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;sin Cookie&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;&lt;code&gt;/internal/ · cualquier otra ruta&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;—&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;—&lt;/td&gt;&lt;td style='padding:1px 8px;border-bottom:1px solid #A5D8FF'&gt;404 NOT_FOUND: lo interno nunca se publica&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#212529;" vertex="1" parent="1"><mxGeometry x="1205" y="82" width="1305" height="250" as="geometry"/></mxCell>
