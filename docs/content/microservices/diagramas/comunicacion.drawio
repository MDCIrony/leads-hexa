<mxCell id="v81" value="SQL (psycopg, sin ORM)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#212529;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="441" width="400" height="22" as="geometry"/></mxCell>
<mxCell id="v82" value="&lt;b style='font-size:13px'&gt;Phantom token&lt;/b&gt;&lt;ol style='margin:4px 0 0 0;padding-left:18px;line-height:1.4'&gt;&lt;li&gt;El cliente envía su cookie opaca o su X-Api-Key.&lt;/li&gt;&lt;li&gt;El gateway pregunta a identity con &lt;code&gt;auth_request&lt;/code&gt;; la introspección no autoriza, sólo identifica.&lt;/li&gt;&lt;li&gt;identity devuelve el JWT interno: iss identity, aud lead-router, sub, tid, role, ptype human|integration, 60 s. 401 → sobre UNAUTHORIZED; sin respuesta → 503.&lt;/li&gt;&lt;li&gt;El gateway reenvía &lt;code&gt;Authorization: Bearer&lt;/code&gt; y quita Cookie y X-Api-Key.&lt;/li&gt;&lt;li&gt;Cada servicio verifica firma, iss, aud y exp con la JWKS (GET /internal/v1/jwks, caché 60 s); KeysUnavailable → 503.&lt;/li&gt;&lt;/ol&gt;&lt;b style='font-size:13px'&gt;Tokens de servicio&lt;/b&gt;&lt;br&gt;Client credentials: POST /internal/v1/service-tokens → JWT de 300 s, ptype service, misma clave y misma JWKS. lead-core pide aud identity; intake pide aud lead-core. Caché hasta 30 s antes de caducar; 401 → invalidate()." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=0;fillColor=#F8F9FA;strokeColor=#ADB5BD;fontColor=#212529;fontSize=13;align=left;verticalAlign=top;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="530" height="345" as="geometry"/></mxCell>
<mxCell id="v83" value="&lt;b style='font-size:13px'&gt;Correlación&lt;/b&gt;&lt;br&gt;Un X-Request-Id recorre&lt;br&gt;la petición, el job, la&lt;br&gt;admisión y el evento" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#212529;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1348" width="260" height="84" as="geometry"/></mxCell>
<mxCell id="v84" value="gateway: conserva un X-Request-Id seguro o genera &lt;code&gt;$request_id&lt;/code&gt;; lo reenvía y lo devuelve" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#212529;fontSize=13;align=left;verticalAlign=top;spacing=8;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="1358" width="290" height="72" as="geometry"/></mxCell>
<mxCell id="v85" value="API: &lt;code&gt;chassis.web&lt;/code&gt; lo pone en &lt;code&gt;request_id_var&lt;/code&gt; y en cada línea de log" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#212529;fontSize=13;align=left;verticalAlign=top;spacing=8;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="618" y="1358" width="290" height="72" as="geometry"/></mxCell>
