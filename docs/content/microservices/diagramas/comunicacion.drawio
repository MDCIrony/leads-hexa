<mxCell id="v12" value="&lt;b&gt;identity&lt;/b&gt; · API FastAPI&lt;br&gt;Pública: /auth, /agents, /tenants&lt;br&gt;Interna: /internal/v1/auth/introspect · jwks · service-tokens · agents/{agent_id}&lt;br&gt;Firma el JWT interno y los tokens de servicio (Ed25519, SIGNING_KEYS)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#212529;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="635" y="462" width="370" height="128" as="geometry"/></mxCell>
<mxCell id="v13" value="&lt;b&gt;lead-core&lt;/b&gt; · API FastAPI&lt;br&gt;Pública: /leads, /rules, /groups, /advisors&lt;br&gt;Interna: POST y GET /internal/v1/admissions (sub=intake, aud=lead-core)&lt;br&gt;⑤ verifica el JWT con la JWKS · AdvisorDirectory hidrata advisors" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#212529;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1135" y="462" width="370" height="128" as="geometry"/></mxCell>
<mxCell id="v14" value="&lt;b&gt;intake&lt;/b&gt; · API FastAPI&lt;br&gt;Pública: /sources, /intake/* (ingest, batch-upload, jobs, records, stats)&lt;br&gt;Encola por outbox (channel job), nunca directo a RabbitMQ&lt;br&gt;⑤ verifica el JWT con la JWKS" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#212529;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1635" y="462" width="370" height="128" as="geometry"/></mxCell>
<mxCell id="v15" value="&lt;b&gt;notifications&lt;/b&gt; · API FastAPI&lt;br&gt;Pública: /notifications&lt;br&gt;Sólo lee y marca la bandeja&lt;br&gt;⑤ verifica el JWT con la JWKS" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#212529;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2135" y="462" width="370" height="128" as="geometry"/></mxCell>
