# Node / Frontend
node_modules/
dist/
.vite/

# Python / Backend
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
*.egg-info/
.uv/

# DB & Temp
*.sqlite
*.db
.env
.idea/

# AI / Gemini
.gemini/

# Template with placeholder values only; it documents the required vars, unlike the real .env above.
!.env.example

# MkDocs build output. The site is generated, never committed.
docs/site/

# Planes de trabajo de sesión: material de despacho para subagentes, no del proyecto.
.plans/

# Material de la presentación del MVP: guion, chuleta y ficheros de prueba.
.mvp-presentacion/

# Artefactos de la herramienta de navegador (capturas y trazas de sesiones de depuración).
.playwright-mcp/

# Presentación: el fuente se versiona, lo instalado y lo construido no.
.slides/node_modules/
.slides/dist/
.slides-events/node_modules/
.slides-events/dist/

# Planes de trabajo por punto pendiente: material de despacho, no del proyecto.
.todo/

# Estado de ejecución de planes por subagentes (ledger, briefs, informes).
.superpowers/

# Credenciales que emite el sembrado de la demo contra la pila local. Se
# regeneran con `python3 demo/seed.py`; commitearlas sería publicar un secreto.
demo/credenciales.local.json

# Base de datos de la aplicación consumidora de prueba, cuando se ejecuta fuera
# de su contenedor.
test-consumer/data/
