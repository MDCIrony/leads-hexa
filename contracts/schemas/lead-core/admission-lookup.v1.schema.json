{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead-core.admission-lookup.v1",
  "title": "Admission lookup, v1",
  "description": "200 body of GET /internal/v1/admissions. Unknown ids are absent.",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "intake_record_id",
          "tenant_id",
          "lead_id"
        ],
        "properties": {
          "intake_record_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "lead_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
