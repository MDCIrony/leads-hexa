{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake.job-message.v1",
  "title": "Intake job message, v1",
  "description": "Body of the RabbitMQ message on the intake.jobs queue.",
  "type": "object",
  "required": [
    "message_id",
    "schema_version",
    "tenant_id",
    "job_id",
    "correlation_id"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "schema_version": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
