meta {
  name: Log in as the second agent
  type: http
  seq: 17
  tags: [
    flow
  ]
}

post {
  url: {{apiBase}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{otherAgentEmail}}
  password: {{password}}
}

vars:post-response {
  otherAgentToken: res.body.access_token
}

assert {
  res.status: eq 200
  res.body.access_token: isString
}

docs {
  # El token de quien no es dueño del lead, aunque comparta organización

  `otherAgentToken` es de un `AGENT`, no de un `MANAGER`, y de la misma organización que el lead:
  la variable menos favorable para demostrar que el aislamiento fino dentro de una organización
  también existe.
}
