meta {
  name: Log in as the second agent
  type: http
  seq: 17
  tags: [
    flow
  ]
}

post {
  url: {{apiBase}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{otherAgentEmail}}
  password: {{password}}
}

vars:post-response {
  otherAgentSession: res.headers['set-cookie']?.join(';').match(/leads_session=([^;]+)/)?.[1]
}

assert {
  res.status: eq 200
  res.body.status: eq AUTHENTICATED
  otherAgentSession: isString
}

docs {
  # La sesión de quien no es dueño del lead, aunque comparta organización

  `otherAgentSession` es de un `AGENT`, no de un `MANAGER`, y de la misma organización que el lead:
  la variable menos favorable para demostrar que el aislamiento fino dentro de una organización
  también existe.
}
