meta {
  name: Create an assignment rule in A
  type: http
  seq: 6
  tags: [
    flow
  ]
}

post {
  url: {{apiBase}}/rules/assignment
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Todo a Carlos {{runId}}",
    "min_score": 0,
    "max_score": null,
    "target_agent_ids": ["{{agentId}}"],
    "agent_match_mode": "ANY",
    "strategy": "DIRECT_AGENT",
    "priority": 10,
    "conditions": []
  }
}

vars:post-response {
  assignmentRuleId: res.body.id
}

assert {
  res.status: eq 201
  res.body.strategy: eq DIRECT_AGENT
}

docs {
  # Reparto dentro de Alpha

  La misma regla mínima de `lead-processing`: manda cualquier lead que llegue hasta la etapa de
  reparto al único asesor de Alpha, sin condiciones y sin techo de puntuación. Lo que importa aquí
  no es la cascada de reparto, sino tener un lead `ASSIGNED` de verdad para poder demostrar después
  que nadie de fuera de Alpha lo alcanza.
}
