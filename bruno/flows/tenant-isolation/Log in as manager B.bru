meta {
  name: Log in as manager B
  type: http
  seq: 11
  tags: [
    flow
  ]
}

post {
  url: {{apiBase}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{managerEmailB}}
  password: {{password}}
}

vars:post-response {
  managerSessionB: res.headers['set-cookie']?.join(';').match(/leads_session=([^;]+)/)?.[1]
}

assert {
  res.status: eq 200
  res.body.status: eq AUTHENTICATED
  managerSessionB: isString
}

docs {
  # El gestor de Beta entra con su propia sesión

  `managerSessionB` lleva dentro la organización Beta, y es distinto de `managerSession` — el de Alpha,
  que se guardó en el paso 4 y sigue vivo en variables de ejecución. Los pasos siguientes usan uno
  u otro a propósito, según de qué lado de la frontera quieren preguntar.
}
