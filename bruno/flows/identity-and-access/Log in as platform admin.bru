meta {
  name: Log in as platform admin
  type: http
  seq: 2
  tags: [
    flow
  ]
}

post {
  url: {{apiBase}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{adminEmail}}
  password: {{password}}
}

vars:post-response {
  adminSession: res.headers['set-cookie']?.join(';').match(/leads_session=([^;]+)/)?.[1]
}

assert {
  res.status: eq 200
  res.body.status: eq AUTHENTICATED
  adminSession: isString
}

docs {
  # Entrar como administrador de plataforma

  El cuerpo va como **formulario**, no como JSON: es el esquema `OAuth2PasswordRequestForm`, y el
  correo viaja en el campo `username`. Mandar JSON aquí responde `422`.

  La respuesta no trae ningún token: fija la cookie `leads_session`, que este paso guarda en
  `adminSession`. Este flujo la usa dos veces: para dar de alta la organización más abajo, y para
  demostrar, hacia el final, que un administrador no alcanza dato operativo aunque su sesión sea
  perfectamente válida.
}
