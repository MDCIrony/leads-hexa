meta {
  name: Log in as the sales agent
  type: http
  seq: 6
  tags: [
    flow
  ]
}

post {
  url: {{apiBase}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{agentEmail}}
  password: {{password}}
}

vars:post-response {
  agentSession: res.headers['set-cookie']?.join(';').match(/leads_session=([^;]+)/)?.[1]
}

assert {
  res.status: eq 200
  res.body.status: eq AUTHENTICATED
  agentSession: isString
}

docs {
  # El asesor entra con lo que acaba de crear su gestor

  Mismo endpoint público que los dos logins anteriores, con una identidad distinta. `agentSession`
  queda guardado para el resto del flujo: lo usan tanto los pasos que comprueban qué alcanza un
  `AGENT` como el último paso, que reutiliza esta misma sesión —sin volver a entrar— para demostrar
  que deja de servir en cuanto se desactiva a quien lo tiene.
}
