meta {
  name: Await processing
  type: http
  seq: 10
  tags: [
    flow
  ]
}

get {
  url: {{apiBase}}/intake/jobs/{{jobId}}
  body: none
  auth: inherit
}

script:post-response {
  const TERMINAL = ["COMPLETED", "FAILED"];
  const MAX_ATTEMPTS = 25;
  const WAIT_MS = 200;

  // Distintas versiones del cliente devuelven el cuerpo en `data` o en `body`.
  const unwrap = (r) => (r && r.data !== undefined ? r.data : r && r.body);

  const url = `${bru.getEnvVar("apiBase")}/intake/jobs/${bru.getVar("jobId")}`;
  const headers = { Authorization: `Bearer ${bru.getVar("managerToken")}` };

  let job = res.body;
  let attempts = 0;

  while (!TERMINAL.includes(job.status) && attempts < MAX_ATTEMPTS) {
    attempts += 1;
    await bru.sleep(WAIT_MS);
    job = unwrap(await bru.sendRequest({ method: "GET", url, headers }));
  }

  // Se publica el estado alcanzado aunque se agoten los intentos: la comprobación
  // de abajo tiene que poder decir en qué se quedó, no sólo que no llegó.
  bru.setVar("jobStatus", job.status);
  bru.setVar("jobSucceeded", job.succeeded);
  bru.setVar("jobFailed", job.failed);
  bru.setVar("jobTotalItems", job.total_items);
  bru.setVar("jobAttempts", attempts);
}

tests {
  test("el trabajo llegó a un estado terminal", function() {
    expect(bru.getVar("jobStatus"), `se quedó en ${bru.getVar("jobStatus")} tras ${bru.getVar("jobAttempts")} intentos`).to.be.oneOf(["COMPLETED", "FAILED"]);
  });

  test("terminó bien, con su único registro procesado", function() {
    expect(bru.getVar("jobStatus")).to.equal("COMPLETED");
    expect(bru.getVar("jobTotalItems")).to.equal(1);
    expect(bru.getVar("jobSucceeded")).to.equal(1);
    expect(bru.getVar("jobFailed")).to.equal(0);
  });
}

docs {
  # El mismo sondeo de `lead-processing`, aplicado aquí

  Copiado tal cual de `Await lead processing`: consulta el trabajo y, mientras no llegue a un estado
  terminal, vuelve a preguntar tras una pausa corta, hasta 25 veces, con `bru.sendRequest` en lugar de
  encadenar peticiones con `bru.setNextRequest`.

  `COMPLETED` con `succeeded: 1` no dice todavía a quién llegó el aviso — sólo que el lead se
  interpretó y se asignó bien. El paso siguiente es el que comprueba el aviso en sí.
}
