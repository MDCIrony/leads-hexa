meta {
  name: Log in as the new manager
  type: http
  seq: 4
  tags: [
    flow
  ]
}

post {
  url: {{apiBase}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{managerEmail}}
  password: {{password}}
}

vars:post-response {
  managerSession: res.headers['set-cookie']?.join(';').match(/leads_session=([^;]+)/)?.[1]
}

assert {
  res.status: eq 200
  res.body.status: eq AUTHENTICATED
  managerSession: isString
}

script:post-response {
  const MAX_ATTEMPTS = 50;
  const WAIT_MS = 200;

  // Distintas versiones del cliente devuelven el cuerpo en `data` o en `body`.
  const unwrap = (r) => (r && r.data !== undefined ? r.data : r && r.body);
  const hasBoth = (page) => ["FILE_UPLOAD", "MANUAL_FORM"].every(
    (kind) => (page?.items || []).some((s) => s.kind === kind)
  );

  const session = res.headers["set-cookie"]?.join(";").match(/leads_session=([^;]+)/)?.[1];
  const url = `${bru.getEnvVar("apiBase")}/sources`;
  const headers = { Cookie: `leads_session=${session}` };

  // Los orígenes por defecto los crea lead-core cuando Kafka le entrega el alta de la
  // organización, un instante después de que identity responda: se sondea hasta verlos.
  let page = unwrap(await bru.sendRequest({ method: "GET", url, headers }));
  let attempts = 0;
  while (!hasBoth(page) && attempts < MAX_ATTEMPTS) {
    attempts += 1;
    await bru.sleep(WAIT_MS);
    page = unwrap(await bru.sendRequest({ method: "GET", url, headers }));
  }

  bru.setVar("sourcesReady", hasBoth(page));
  bru.setVar("sourcesAttempts", attempts);
}

tests {
  test("los orígenes por defecto de la organización ya existen", function() {
    expect(bru.getVar("sourcesReady"), `no aparecieron tras ${bru.getVar("sourcesAttempts")} intentos`).to.equal(true);
  });
}

docs {
  # El gestor entra con lo que se creó en el paso anterior

  La contraseña que se mandó en el alta se guardó cifrada con bcrypt, y aquí se comprueba contra ese
  hash. Que este login funcione demuestra que el gestor se creó de verdad, con su credencial usable,
  y no como una fila a medias.

  La sesión que abre resuelve, en cada petición, a este gestor y a su organización, así que a partir
  de aquí **no hay que volver a nombrarla**: ni en una URL ni en el cuerpo de ninguna petición. Es la diferencia entre un sistema
  donde el aislamiento entre organizaciones depende de que quien llama diga la verdad, y uno donde
  no se puede ni expresar la mentira.

  ## Esperar a los orígenes

  Este paso no termina hasta que la organización tiene sus orígenes `MANUAL_FORM` y `FILE_UPLOAD`.
  Los crea lead-core al consumir el alta de la organización que identity publica en Kafka, así que
  llegan un instante después del login: una ingesta enviada en el primer segundo recibiría
  `404 SOURCE_NOT_FOUND`. Se sondea `GET /sources` (hasta 50 veces, 200 ms entre intentos) en vez de
  dormir un tiempo fijo, como hacen los demás pasos de espera de la colección.
}
